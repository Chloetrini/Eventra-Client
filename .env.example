# Copy this file to .env for local development, and set the same
# variables in your Vercel project (Project Settings -> Environment
# Variables) before deploying. Without VITE_API_URL set in Vercel, the
# deployed site will build and load fine but every API call will fail,
# since the frontend and backend are hosted separately.

# Base URL of the deployed Eventra backend API, including the version
# prefix, e.g. https://api.example.com/api/v1
VITE_API_URL=

# Google OAuth client ID used for "Continue with Google" login/signup.
VITE_GOOGLE_CLIENT_ID=
