# Optional. Defaults to the hosted backend in app.json (extra.apiUrl).
# For local dev use your machine's LAN IP, not localhost (a phone can't reach it).
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1

# Google sign-in (optional; the button stays hidden until the web client id is set).
# Same value as the website's VITE_GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only needed once an iOS OAuth client exists: the "iOS URL scheme" Google shows for it.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
